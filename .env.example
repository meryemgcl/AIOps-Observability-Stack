# Zorunlu: Groq Cloud API Anahtarınızı buraya yazın
# https://console.groq.com adresinden ücretsiz alabilirsiniz.
GROQ_API_KEY=your_groq_api_key_here

# Opsiyonel: Telegram Bot Entegrasyonu
# BotFather'dan aldığınız token ve mesajı alacak kişinin/grubun Chat ID'si
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kaç saniyede bir AI analizi yapılsın (varsayılan: 60 saniye)
ANALYSIS_INTERVAL_SECONDS=60
